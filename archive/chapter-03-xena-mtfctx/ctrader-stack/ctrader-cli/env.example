# Copy to tools/ctrader-cli/.env and fill in locally.
# Do not commit real credentials.

CTRADER_CTID="your-ctid-or-email"
CTRADER_ACCOUNT="1234567"
CTRADER_PWD_FILE="/Users/jerryinyang/cAlgo/Sources/Robots/Xen/Xen/tools/ctrader-cli/ctrader-cli.pwd"

# Stable canonical cache namespace under tools/ctrader-cli/data/<account>/<symbol>/<timeframe>.
# Defaults to CTRADER_ACCOUNT when omitted.
# CTRADER_CACHE_ACCOUNT="1234567"

# Optional. Set only if cTrader creates a different provider directory under data/V1.
# Existing provider directories are detected automatically.
# CTRADER_CACHE_PROVIDER="demo_xxxxxxxx"

# Optional, only needed if your cTID has ambiguous account numbers across brokers.
# CTRADER_BROKER="broker-name"

# Defaults are correct for this Mac/docker setup.
CTRADER_IMAGE="ghcr.io/spotware/ctrader-console:latest"
CTRADER_PLATFORM="linux/amd64"
